# ==============================================================================
# KUMBHAKARAN MULTI-SALON DISCOVERY & MANAGEMENT PLATFORM
# Environment Variables Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. NestJS + Fastify Backend Configuration
# ------------------------------------------------------------------------------
PORT=3001
NODE_ENV=development

# Supabase PostgreSQL Connection String (PostGIS Enabled)
# For Supabase: Project Settings -> Database -> Connection string -> URI
# Use Connection Pooling URI (port 6543 / 5432) or Direct Connection (port 5432)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?pgbouncer=true
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@[YOUR-HOST].supabase.co:5432/postgres

# Direct Connection URL (Used for Prisma migrations and schema inspections)
# DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@[YOUR-HOST].supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# 2. Frontend React Client Configuration
# ------------------------------------------------------------------------------
# API and Real-time WebSocket Gateway
VITE_API_BASE_URL=http://localhost:3001/api/v1
VITE_WS_BASE_URL=http://localhost:3001

# Mapbox Vector Maps (Frontend Studio Location & Pin Rendering)
# Obtain from: https://account.mapbox.com/
VITE_MAPBOX_ACCESS_TOKEN=pk.your_mapbox_public_token_here

# Google Maps Platform (Directions Deep-Links & Navigation)
# Obtain from: https://console.cloud.google.com/
# Required APIs to enable: Maps JavaScript API, Places API, Geocoding API
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_browser_api_key_here

# Google Maps Vector Map ID (Optional for custom dark mode vector rendering)
# Obtain from: Google Maps Platform -> Map Management -> Create Map ID
VITE_GOOGLE_MAP_ID=your_google_map_id_here

# Google OAuth 2.0 Web Client ID
# Obtain from: Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Cross-App Inter-Navigation URLs (For Vercel & Production)
VITE_CUSTOMER_APP_URL=https://customer-web-inky.vercel.app/
VITE_PARTNER_APP_URL=https://project-1-xq1k.vercel.app/
VITE_ADMIN_APP_URL=http://localhost:5175
