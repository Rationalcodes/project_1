// ==============================================================================
// KUMBHAKARAN PLATFORM - PRISMA SCHEMA FOR SUPABASE POSTGIS
// ==============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = []
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 1. Salons Entity
model Salon {
  id                      String   @id @db.VarChar(64)
  name                    String   @db.VarChar(255)
  tagline                 String?
  ownerName               String   @map("owner_name") @db.VarChar(255)
  ownerId                 String?  @map("owner_id") @db.VarChar(64)
  phone                   String   @db.VarChar(50)
  email                   String?  @db.VarChar(255)
  address                 String
  locality                String   @db.VarChar(100)
  city                    String   @db.VarChar(100)
  state                   String?  @db.VarChar(100)
  pincode                 String   @db.VarChar(20)

  // Spatial coordinates
  latitude                Float
  longitude               Float
  // PostGIS Point column mapped as Unsupported in Prisma.
  // Queried and mutated via parameterized raw PostGIS SQL functions (ST_DWithin, ST_Distance, ST_MakePoint).
  location                Unsupported("geography(Point, 4326)")

  coverImage              String?  @map("cover_image")
  openingHoursOpen        String?  @default("09:00 AM") @map("opening_hours_open") @db.VarChar(20)
  openingHoursClose       String?  @default("09:30 PM") @map("opening_hours_close") @db.VarChar(20)
  openingHoursFormatted   String?  @default("09:00 AM – 09:30 PM (All Days)") @map("opening_hours_formatted") @db.VarChar(100)

  // Live walk-in queue telemetry
  currentQueue            Int      @default(0) @map("current_queue")
  avgServiceTimeMinutes   Int      @default(20) @map("avg_service_time_minutes")
  activeBarbers           Int      @default(2) @map("active_barbers")
  isOpen                  Boolean  @default(true) @map("is_open")
  queueStatus             String?  @default("open") @map("queue_status") @db.VarChar(20) // 'open', 'paused', 'closed'
  lastQueueUpdate         DateTime @default(now()) @map("last_queue_update") @db.Timestamptz

  // Platform governance
  rating                  Decimal  @default(5.0) @db.Decimal(2, 1)
  reviewCount             Int      @default(0) @map("review_count")
  startingPrice           Decimal  @default(150.0) @map("starting_price") @db.Decimal(10, 2)
  isVerified              Boolean  @default(false) @map("is_verified")
  status                  String   @default("active") @db.VarChar(20)
  smartQueueGeofenceRadiusMeters Int @default(100) @map("smart_queue_geofence_radius_meters")

  todayCustomersServed    Int      @default(0) @map("today_customers_served")
  todayRevenue            Decimal  @default(0.0) @map("today_revenue") @db.Decimal(12, 2)
  monthlyRevenue          Decimal  @default(0.0) @map("monthly_revenue") @db.Decimal(12, 2)
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  services                SalonService[]
  staff                   SalonStaff[]
  reviews                 SalonReview[]
  members                 SalonMember[]
  queueEntries            SalonQueueEntry[]
  serviceSessions         ServiceSession[]
  queueEvents             QueueEvent[]

  @@map("salons")
}

// 2. Salon Services Entity
model SalonService {
  id              String   @id @db.VarChar(64)
  salonId         String   @map("salon_id") @db.VarChar(64)
  name            String   @db.VarChar(255)
  category        String   @db.VarChar(50)
  price           Decimal  @db.Decimal(10, 2)
  durationMinutes Int      @default(20) @map("duration_minutes")
  description     String?
  isAvailable     Boolean  @default(true) @map("is_available")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  salon           Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)

  @@index([salonId, category], map: "idx_services_salon_category")
  @@map("salon_services")
}

// 3. Salon Staff Entity
model SalonStaff {
  id                   String            @id @db.VarChar(64)
  salonId              String            @map("salon_id") @db.VarChar(64)
  name                 String            @db.VarChar(255)
  role                 String?           @default("Master Barber") @db.VarChar(100)
  experience           String?           @db.VarChar(50)
  specialties          String[]
  photo                String?
  status               String            @default("active") @db.VarChar(20) // 'active', 'inactive'
  availability         String            @default("AVAILABLE") @map("availability") @db.VarChar(20) // 'AVAILABLE', 'BUSY', 'ON_BREAK', 'OFFLINE'
  currentQueueEntryId  String?           @map("current_queue_entry_id") @db.VarChar(64)
  breakStartedAt       DateTime?         @map("break_started_at") @db.Timestamptz
  workingHoursStart    String?           @default("09:00 AM") @map("working_hours_start") @db.VarChar(20)
  workingHoursEnd      String?           @default("09:00 PM") @map("working_hours_end") @db.VarChar(20)
  assignedServices     String[]          @default([]) @map("assigned_services")
  rating               Decimal           @default(4.9) @db.Decimal(2, 1)
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz

  salon                Salon             @relation(fields: [salonId], references: [id], onDelete: Cascade)
  assignedQueueEntries SalonQueueEntry[]
  serviceSessions      ServiceSession[]

  @@map("salon_staff")
}

// 4. Salon Reviews Entity (Customer Name only)
model SalonReview {
  id                String    @id @db.VarChar(64)
  salonId           String    @map("salon_id") @db.VarChar(64)
  customerName      String    @map("customer_name") @db.VarChar(100)
  customerAvatar    String?   @map("customer_avatar")
  rating            Int
  comment           String
  verifiedVisit     Boolean   @default(true) @map("verified_visit")

  haircutQuality    Int       @default(5) @map("haircut_quality")
  staffBehaviour    Int       @default(5) @map("staff_behaviour")
  cleanliness       Int       @default(5) @map("cleanliness")
  pricing           Int       @default(5) @map("pricing")
  overallExperience Int       @default(5) @map("overall_experience")

  ownerReply        String?   @map("owner_reply")
  ownerReplyDate    DateTime? @map("owner_reply_date") @db.Timestamptz
  flagged           Boolean   @default(false)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz

  salon             Salon     @relation(fields: [salonId], references: [id], onDelete: Cascade)

  @@map("salon_reviews")
}

// 5. Users Entity (Global Platform Role: CUSTOMER or ADMIN)
model User {
  id           String        @id @db.VarChar(64)
  googleId     String?       @unique @map("google_id") @db.VarChar(128)
  email        String        @unique @db.VarChar(255)
  name         String        @db.VarChar(255)
  avatarUrl    String?       @map("avatar_url")
  phone        String?       @db.VarChar(50)
  role         String        @default("CUSTOMER") @db.VarChar(20)
  lastLogoutAt DateTime?     @map("last_logout_at") @db.Timestamptz
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  memberships  SalonMember[]

  @@map("users")
}

// 6. Salon Memberships Entity (Salon-specific role: PARTNER_OWNER or PARTNER_STAFF)
model SalonMember {
  id        String   @id @db.VarChar(64)
  salonId   String   @map("salon_id") @db.VarChar(64)
  userId    String   @map("user_id") @db.VarChar(64)
  role      String   @default("PARTNER_STAFF") @db.VarChar(30)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  salon     Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([salonId, userId], map: "uq_salon_member")
  @@index([salonId], map: "idx_salon_members_salon")
  @@index([userId], map: "idx_salon_members_user")
  @@map("salon_members")
}

// 7. Administrator Audit Logs
model AdminAuditLog {
  id         String   @id @db.VarChar(64)
  actorId    String   @map("actor_id") @db.VarChar(64)
  actorEmail String   @map("actor_email") @db.VarChar(255)
  action     String   @db.VarChar(50)
  targetType String   @map("target_type") @db.VarChar(50)
  targetId   String   @map("target_id") @db.VarChar(64)
  targetName String?  @map("target_name") @db.VarChar(255)
  details    Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([actorId], map: "idx_audit_actor")
  @@index([targetId], map: "idx_audit_target")
  @@map("admin_audit_logs")
}

// 8. Salon Queue Entries Entity (Live Common Salon Queue)
model SalonQueueEntry {
  id                      String          @id @db.VarChar(64)
  salonId                 String          @map("salon_id") @db.VarChar(64)
  clientRequestId         String?         @map("client_request_id") @db.VarChar(36)
  position                Int             @default(1)
  ticketNumber            String?         @map("ticket_number") @db.VarChar(32)
  customerName            String          @map("customer_name") @db.VarChar(100)
  phone                   String?         @db.VarChar(50)
  serviceName             String          @map("service_name") @db.VarChar(255)
  serviceId               String?         @map("service_id") @db.VarChar(64)
  serviceDuration         Int             @default(20) @map("service_duration")
  servicePrice            Decimal         @default(150.0) @map("service_price") @db.Decimal(10, 2)
  assignedStaffId         String?         @map("assigned_staff_id") @db.VarChar(64)
  status                  String          @default("waiting") @db.VarChar(20) // 'waiting', 'called', 'in_service', 'completed', 'skipped', 'cancelled', 'no_show'
  joinedAt                DateTime        @default(now()) @map("joined_at") @db.Timestamptz
  calledAt                DateTime?       @map("called_at") @db.Timestamptz
  startedAt               DateTime?       @map("started_at") @db.Timestamptz
  servedAt                DateTime?       @map("served_at") @db.Timestamptz
  cancelledAt             DateTime?       @map("cancelled_at") @db.Timestamptz
  estimatedWaitMinutes    Int             @default(0) @map("estimated_wait_minutes")
  estimatedStartTime      DateTime?       @map("estimated_start_time") @db.Timestamptz
  estimatedCompletionTime DateTime?       @map("estimated_completion_time") @db.Timestamptz
  extendedMinutes         Int             @default(0) @map("extended_minutes")
  deviceId                String?         @map("device_id") @db.VarChar(128)
  userId                  String?         @map("user_id") @db.VarChar(64)
  notes                   String?
  cancellationReason      String?         @map("cancellation_reason") @db.VarChar(255)
  checkInMethod           String          @default("online") @map("check_in_method") @db.VarChar(20)
  partySize               Int             @default(1) @map("party_size")
  locationConsent         Boolean         @default(false) @map("location_consent")
  arrivalConfirmedAt      DateTime?       @map("arrival_confirmed_at") @db.Timestamptz
  lastLocationObservedAt  DateTime?       @map("last_location_observed_at") @db.Timestamptz
  lastLocationAccuracy    Float?          @map("last_location_accuracy")
  outsideObservationCount Int             @default(0) @map("outside_observation_count")
  firstOutsideObservedAt  DateTime?       @map("first_outside_observed_at") @db.Timestamptz
  departureDetectedAt     DateTime?       @map("departure_detected_at") @db.Timestamptz
  departureConfirmedAt    DateTime?       @map("departure_confirmed_at") @db.Timestamptz
  departureConfirmationSource String?     @map("departure_confirmation_source") @db.VarChar(30)
  departureReviewRequired Boolean         @default(false) @map("departure_review_required")
  updatedAt               DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  salon                   Salon           @relation(fields: [salonId], references: [id], onDelete: Cascade)
  assignedStaff           SalonStaff?     @relation(fields: [assignedStaffId], references: [id], onDelete: SetNull)
  serviceSession          ServiceSession?
  events                  QueueEvent[]

  @@index([salonId, status], map: "idx_queue_salon_status")
  @@index([salonId, joinedAt], map: "idx_queue_joined")
  @@unique([salonId, clientRequestId], map: "uq_queue_salon_request")
  @@map("salon_queue_entries")
}

// 9. Service Sessions (Historical completed service records)
model ServiceSession {
  id                      String          @id @db.VarChar(64)
  salonId                 String          @map("salon_id") @db.VarChar(64)
  queueEntryId            String?         @unique @map("queue_entry_id") @db.VarChar(64)
  staffId                 String?         @map("staff_id") @db.VarChar(64)
  customerName            String          @map("customer_name") @db.VarChar(100)
  serviceName             String          @map("service_name") @db.VarChar(255)
  startedAt               DateTime        @map("started_at") @db.Timestamptz
  completedAt             DateTime?       @map("completed_at") @db.Timestamptz
  expectedDurationMinutes Int             @map("expected_duration_minutes")
  actualDurationMinutes   Int?            @map("actual_duration_minutes")
  price                   Decimal         @db.Decimal(10, 2)
  notes                   String?
  createdAt               DateTime        @default(now()) @map("created_at") @db.Timestamptz

  salon                   Salon           @relation(fields: [salonId], references: [id], onDelete: Cascade)
  queueEntry              SalonQueueEntry? @relation(fields: [queueEntryId], references: [id], onDelete: SetNull)
  staff                   SalonStaff?     @relation(fields: [staffId], references: [id], onDelete: SetNull)

  @@index([salonId, startedAt], map: "idx_sessions_salon")
  @@map("service_sessions")
}

// 10. Queue Events Audit Log
model QueueEvent {
  id                      String          @id @db.VarChar(64)
  salonId                 String          @map("salon_id") @db.VarChar(64)
  queueEntryId            String?         @map("queue_entry_id") @db.VarChar(64)
  actorId                 String?         @map("actor_id") @db.VarChar(64)
  actorRole               String?         @map("actor_role") @db.VarChar(50)
  eventType               String          @map("event_type") @db.VarChar(50)
  fromStatus              String?         @map("from_status") @db.VarChar(20)
  toStatus                String?         @map("to_status") @db.VarChar(20)
  details                 Json?
  createdAt               DateTime        @default(now()) @map("created_at") @db.Timestamptz

  salon                   Salon           @relation(fields: [salonId], references: [id], onDelete: Cascade)
  queueEntry              SalonQueueEntry? @relation(fields: [queueEntryId], references: [id], onDelete: Cascade)

  @@index([queueEntryId, createdAt], map: "idx_events_entry")
  @@index([salonId, createdAt], map: "idx_events_salon")
  @@map("queue_events")
}
